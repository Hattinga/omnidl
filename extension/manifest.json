{
  "manifest_version": 3,
  "name": "omnidl",
  "version": "0.2.0",
  "description": "Schickt die offene Seite oder einen Link an omnidl – als Video oder Audio.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "An omnidl senden",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["omnidl.js", "background.js"]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "omnidl öffnen"
    }
  },
  "permissions": ["activeTab", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:47813/*"],
  "browser_specific_settings": {
    "gecko": { "id": "omnidl@hattinga.github.io", "strict_min_version": "121.0" }
  }
}
